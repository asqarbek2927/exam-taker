# Copy to .env.production and replace every CHANGE_ME value. Never commit the real file.
DOMAIN=api.example.com
LETSENCRYPT_EMAIL=admin@example.com

DJANGO_SETTINGS_MODULE=config.settings.prod
SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_50_RANDOM_CHARACTERS
ALLOWED_HOSTS=api.example.com

POSTGRES_DB=examtaker
POSTGRES_USER=examtaker
# Use a long URL-safe password, or percent-encode it inside DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgres://examtaker:CHANGE_ME_DATABASE_PASSWORD@db:5432/examtaker
DB_CONN_MAX_AGE=60

# Frontend origin and backend origin: scheme is required, trailing slash is not.
CORS_ALLOWED_ORIGINS=https://app.example.com
CSRF_TRUSTED_ORIGINS=https://api.example.com

SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
SECURE_HSTS_PRELOAD=false

ENABLE_API_DOCS=false
NUM_PROXIES=1
WEB_CONCURRENCY=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=120
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
ATTEMPT_GRACE_SECONDS=10
BACKUP_RETENTION_DAYS=14
