# Copy this file to .env.aws. Never commit .env.aws.
# Generate SECRET_KEY with a long random value (at least 50 characters).
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY

# Public EC2 IPv4 or domain only, without http:// and without a trailing slash.
ALLOWED_HOSTS=YOUR_EC2_PUBLIC_IP

# PostgreSQL password should be long and URL-safe (letters/digits recommended here).
POSTGRES_DB=examtaker
POSTGRES_USER=examtaker
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgres://examtaker:CHANGE_ME_DATABASE_PASSWORD@db:5432/examtaker
DB_CONN_MAX_AGE=60

# Add the frontend origins, with scheme and port when it is not 80.
CORS_ALLOWED_ORIGINS=http://YOUR_FRONTEND_HOST
CSRF_TRUSTED_ORIGINS=http://YOUR_EC2_PUBLIC_IP

# Keep Swagger enabled only during frontend integration.
ENABLE_API_DOCS=true
WEB_CONCURRENCY=3
LOG_LEVEL=INFO
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
